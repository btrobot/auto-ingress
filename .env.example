# Auto Ingress v2 - Forge deploy configuration
# Copy to .env and fill in actual values

# === Required ===
COMPOSE_PROJECT_NAME=auto-ingress
GATEWAY_IMAGE=ccr.ccs.tencentyun.com/nodecoda/auto-ingress:2.3.0

# === Optional: Docker socket ===
# DOCKER_SOCKET=/var/run/docker.sock
# DOCKER_GID=988

# === Optional: Resource limits ===
# MEM_LIMIT=256m
# PIDS_LIMIT=256

# Note: Application config (ACME email, DNS provider, sites, etc.)
# lives in auto-ingress.yaml, not in this file.
# DNS secrets live in edge-dns.env.
