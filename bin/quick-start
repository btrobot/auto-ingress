#!/usr/bin/env bash
set -euo pipefail

# Auto Ingress Quick Start Script

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${GREEN}=== Auto Ingress Quick Start ===${NC}"
echo ""

# Check Docker
if ! command -v docker &> /dev/null; then
    echo -e "${RED}ERROR: Docker not found${NC}"
    echo "Install Docker: https://docs.docker.com/get-docker/"
    exit 1
fi

# Check Docker Compose
if ! docker compose version &> /dev/null; then
    echo -e "${RED}ERROR: Docker Compose not found${NC}"
    echo "Install Docker Compose: https://docs.docker.com/compose/install/"
    exit 1
fi

echo -e "${GREEN}✓ Docker found${NC}"
echo -e "${GREEN}✓ Docker Compose found${NC}"
echo ""

# Create config directory
CONFIG_DIR="${AUTO_INGRESS_CONFIG:-/etc/auto-ingress}"
mkdir -p "$CONFIG_DIR"

# Copy example config if not exists
if [[ ! -f "$CONFIG_DIR/gateway.env" ]]; then
    echo -e "${YELLOW}Creating example configuration...${NC}"
    cp examples/generic.env "$CONFIG_DIR/gateway.env"
    echo -e "${GREEN}✓ Created $CONFIG_DIR/gateway.env${NC}"
else
    echo -e "${GREEN}✓ Configuration exists: $CONFIG_DIR/gateway.env${NC}"
fi

if [[ ! -f "$CONFIG_DIR/dns.env" ]]; then
    echo -e "${YELLOW}Creating example DNS configuration...${NC}"
    cp examples/dns-tencentcloud.env "$CONFIG_DIR/dns.env"
    chmod 600 "$CONFIG_DIR/dns.env"
    echo -e "${GREEN}✓ Created $CONFIG_DIR/dns.env${NC}"
else
    echo -e "${GREEN}✓ DNS config exists: $CONFIG_DIR/dns.env${NC}"
fi

echo ""
echo -e "${GREEN}=== Next Steps ===${NC}"
echo ""
echo "1. Edit configuration:"
echo "   vim $CONFIG_DIR/gateway.env"
echo ""
echo "2. Edit DNS credentials:"
echo "   vim $CONFIG_DIR/dns.env"
echo ""
echo "3. Test configuration:"
echo "   ./bin/test-config $CONFIG_DIR/gateway.env"
echo ""
echo "4. Generate Caddyfile (optional):"
echo "   ./bin/generate-config $CONFIG_DIR/gateway.env Caddyfile"
echo ""
echo "5. Start gateway:"
echo "   docker compose up -d"
echo ""
echo "6. Check status:"
echo "   docker compose ps"
echo "   docker compose logs -f"
echo ""
echo -e "${YELLOW}For more information, see README.md${NC}"
