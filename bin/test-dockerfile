#!/usr/bin/env bash
set -euo pipefail

# Test Dockerfile syntax and build

GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

echo "Testing Dockerfile..."

# Check if hadolint is available
if command -v hadolint &> /dev/null; then
    echo -e "${GREEN}Running hadolint...${NC}"
    hadolint Dockerfile || echo -e "${RED}hadolint warnings found${NC}"
else
    echo "hadolint not found, skipping lint"
fi

# Test build (dry-run)
echo -e "${GREEN}Testing build syntax...${NC}"
docker build --check . 2>/dev/null || \
    docker build --dry-run . 2>/dev/null || \
    echo "Build syntax check not supported, proceeding..."

echo -e "${GREEN}Dockerfile test completed${NC}"
