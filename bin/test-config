#!/usr/bin/env bash
set -euo pipefail

# Test Auto Ingress Configuration

CONFIG_FILE="${1:?Usage: test-config <gateway.env>}"

echo "Testing configuration: $CONFIG_FILE"

# Source configuration
set -a
source "$CONFIG_FILE"
set +a

# Validate required variables
REQUIRED_VARS=(
    "GATEWAY_IMAGE"
    "COMPOSE_PROJECT_NAME"
    "DNS_ENV_FILE"
    "DNS_PROVIDER"
    "ACME_EMAIL"
    "SITE_DOMAINS"
    "HEALTH_DOMAIN"
    "UPSTREAM_NETWORK"
)

for var in "${REQUIRED_VARS[@]}"; do
    if [[ -z "${!var:-}" ]]; then
        echo "ERROR: Missing required variable: $var"
        exit 1
    fi
done

# Validate DNS provider
SUPPORTED_PROVIDERS=("tencentcloud" "aliyun" "cloudflare" "aws")
if [[ ! " ${SUPPORTED_PROVIDERS[*]} " =~ " ${DNS_PROVIDER} " ]]; then
    echo "ERROR: Unsupported DNS provider: $DNS_PROVIDER"
    echo "Supported: ${SUPPORTED_PROVIDERS[*]}"
    exit 1
fi

# Validate SITE_DOMAINS format
IFS=',' read -ra SITES <<< "$SITE_DOMAINS"
for site in "${SITES[@]}"; do
    if [[ ! "$site" =~ ^[^:]+:[^:]+:[0-9]+$ ]]; then
        echo "ERROR: Invalid SITE_DOMAINS format: $site"
        echo "Expected: domain:service:port"
        exit 1
    fi
done

# Validate HEALTH_DOMAIN is in SITE_DOMAINS
if [[ ! "$SITE_DOMAINS" =~ "$HEALTH_DOMAIN" ]]; then
    echo "ERROR: HEALTH_DOMAIN ($HEALTH_DOMAIN) not found in SITE_DOMAINS"
    exit 1
fi

# Validate DNS env file
if [[ ! -f "$DNS_ENV_FILE" ]]; then
    echo "WARNING: DNS env file not found: $DNS_ENV_FILE"
fi

echo "Configuration valid!"
echo ""
echo "Domains:"
IFS=',' read -ra SITES <<< "$SITE_DOMAINS"
for site in "${SITES[@]}"; do
    IFS=':' read -r domain service port <<< "$site"
    echo "  - $domain -> $service:$port"
done
echo ""
echo "DNS Provider: $DNS_PROVIDER"
echo "Health Domain: $HEALTH_DOMAIN"
