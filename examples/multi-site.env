# Auto Ingress - Multi-Site Configuration Example
# Multiple domains pointing to different services

# Gateway image
GATEWAY_IMAGE=your-registry/auto-ingress@sha256:...

# Docker Compose project name
COMPOSE_PROJECT_NAME=multi-site-ingress

# DNS provider credentials file
DNS_ENV_FILE=/etc/auto-ingress/dns.env

# DNS provider
DNS_PROVIDER=cloudflare

# ACME email
ACME_EMAIL=ops@example.com

# Site domains and upstream services
# Format: domain1:service1:port1,domain2:service2:port2
SITE_DOMAINS=example.com:web-app:3000,api.example.com:api-server:8080,admin.example.com:admin-panel:3001,docs.example.com:docs-server:4000

# Health check domain (must be one of SITE_DOMAINS)
HEALTH_DOMAIN=example.com

# Upstream Docker network
UPSTREAM_NETWORK=app-network

# Port bindings
HTTP_BIND=0.0.0.0:80
HTTPS_BIND=0.0.0.0:443
