# Auto Ingress - NodeCoda Configuration
# Migrated from nodecoda-edge

# ═══════════════════════════════════════════════════════════════════
# Required Configuration
# ═══════════════════════════════════════════════════════════════════

# Gateway image
GATEWAY_IMAGE=ccr.ccs.tencentyun.com/nodecoda/auto-ingress@sha256:...

# Docker Compose project name
COMPOSE_PROJECT_NAME=nodecoda-edge-production

# Environment file with DNS credentials
GATEWAY_ENV_FILE=/etc/nodecoda/edge-dns.env

# ACME email
ACME_EMAIL=songdiandong@gmail.com

# Site domains and upstream services
# dc-api handles all HTTP traffic
SITE_DOMAINS=nodecoda.com:dc-api:8080,www.nodecoda.com:dc-api:8080

# Upstream network (from dc-saas compose)
UPSTREAM_NETWORK=dc-saas_edge

# ═══════════════════════════════════════════════════════════════════
# Optional Configuration
# ═══════════════════════════════════════════════════════════════════

# DNS provider
DNS_PROVIDER=tencentcloud

# Health check domain
HEALTH_DOMAIN=www.nodecoda.com

# Port bindings
HTTP_BIND=0.0.0.0:80
HTTPS_BIND=0.0.0.0:443
ADMIN_BIND=127.0.0.1:2019

# Resource limits
MEM_LIMIT=192m
PIDS_LIMIT=128
