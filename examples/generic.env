# Auto Ingress - Generic Configuration Example
# Copy to /etc/auto-ingress/gateway.env

# ═══════════════════════════════════════════════════════════════════
# Required Configuration
# ═══════════════════════════════════════════════════════════════════

# Gateway image (must be digest-qualified)
GATEWAY_IMAGE=your-registry/auto-ingress@sha256:...

# Docker Compose project name
COMPOSE_PROJECT_NAME=auto-ingress

# Environment file with DNS credentials
GATEWAY_ENV_FILE=/etc/auto-ingress/dns.env

# ACME email for certificate notifications
ACME_EMAIL=ops@example.com

# Site domains and upstream services
# Format: domain1:service1:port1,domain2:service2:port2
# Example: example.com:web-app:3000,api.example.com:api-server:8080
SITE_DOMAINS=example.com:web-app:3000

# Upstream Docker network (must exist)
UPSTREAM_NETWORK=app-network

# ═══════════════════════════════════════════════════════════════════
# Optional Configuration
# ═══════════════════════════════════════════════════════════════════

# DNS provider (tencentcloud|aliyun|cloudflare|route53)
DNS_PROVIDER=tencentcloud

# Health check domain (must be one of SITE_DOMAINS)
HEALTH_DOMAIN=example.com

# Port bindings
HTTP_BIND=0.0.0.0:80
HTTPS_BIND=0.0.0.0:443
ADMIN_BIND=127.0.0.1:2019

# Resource limits
MEM_LIMIT=256m
PIDS_LIMIT=256

# Custom Caddyfile path (optional)
# CADDYFILE=./Caddyfile
