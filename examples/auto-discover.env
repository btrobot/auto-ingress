# Auto Ingress - 自动发现模式配置
# 自动从 Docker 标签发现服务

# Gateway 镜像
GATEWAY_IMAGE=ccr.ccs.tencentyun.com/nodecoda/auto-ingress:latest

# Docker Compose 项目名
COMPOSE_PROJECT_NAME=auto-ingress

# DNS 凭据文件
GATEWAY_ENV_FILE=/etc/auto-ingress/dns.env

# ACME 邮箱
ACME_EMAIL=ops@example.com

# DNS 提供商
DNS_PROVIDER=tencentcloud

# 上游网络
UPSTREAM_NETWORK=app-network

# 启用自动发现
AUTO_DISCOVER=true

# Docker socket (只读)
DOCKER_SOCKET=/var/run/docker.sock

# 端口绑定
HTTP_BIND=0.0.0.0:80
HTTPS_BIND=0.0.0.0:443
ADMIN_BIND=127.0.0.1:2019

# 资源限制
MEM_LIMIT=256m
PIDS_LIMIT=256
