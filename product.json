{
  "schema_version": "1.0",
  "name": "auto-ingress",
  "version": "2.0.0",
  "description": "Automatic HTTPS reverse proxy gateway CLI",
  "homepage": "https://github.com/nodecoda/auto-ingress",
  "license": "MIT",
  "features": [
    "cli-tool",
    "yaml-configuration",
    "domain-configuration",
    "service-mapping",
    "auto-certificate",
    "auto-renewal",
    "multi-dns-provider",
    "security-headers",
    "health-check",
    "hot-reload",
    "multi-site",
    "non-root-user",
    "read-only-filesystem",
    "config-validation",
    "dry-run-preview",
    "diagnostics"
  ],
  "dns_providers": [
    {"name": "tencentcloud", "module": "github.com/caddy-dns/tencentcloud"},
    {"name": "aliyun", "module": "github.com/caddy-dns/alidns"},
    {"name": "cloudflare", "module": "github.com/caddy-dns/cloudflare"},
    {"name": "route53", "module": "github.com/caddy-dns/route53"},
    {"name": "digitalocean", "module": "github.com/caddy-dns/digitalocean"},
    {"name": "googlecloud", "module": "github.com/caddy-dns/googlecloud"}
  ],
  "runtime": {
    "caddy_version": "2.10.2",
    "base_image": "caddy:2.10.2-alpine",
    "ports": [80, 443, 443, 2019]
  },
  "requirements": {
    "docker": ">=20.10",
    "go": ">=1.22"
  }
}
